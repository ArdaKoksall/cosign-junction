# Docker Compose reads this file from the repository root after you copy it to .env.
VALIO_API_KEY=
NVIDIA_API_KEY=

# Production runtime. Use HTTPS for cloud-hosted MCP clients.
PUBLIC_ORIGIN=http://localhost:8080
# Optional ngrok authtoken and reserved hostname (without https://).
NGROK_TOKEN=
NGROK_DOMAIN=
# Generate independent random values. Keep them stable across restarts.
# Use a URL-safe hex password for the Compose PostgreSQL connection string.
POSTGRES_PASSWORD=
# 32 random bytes, encoded as 64 hex characters; encrypts OAuth client secrets.
OAUTH_ENCRYPTION_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
COSIGN_WEB_PORT=8080
COSIGN_DB_PORT=55432
# Enable simulated fixed-price commitment on an isolated judging workspace.
COSIGN_ENABLE_ORDER_REHEARSAL=false
