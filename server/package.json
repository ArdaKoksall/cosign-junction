{
  "name": "cosign-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "pretest": "prisma generate",
    "pretypecheck": "prisma generate",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "db:import": "tsx scripts/import-legacy.ts",
    "account:create": "tsx src/trade/provision.ts",
    "mcp:local": "node dist/trade/stdio.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ngrok/ngrok": "^1.8.0",
    "@cosign/adapters": "file:../adapters",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fastify": "^5.6.1",
    "helmet": "^8.3.0",
    "pg": "8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
