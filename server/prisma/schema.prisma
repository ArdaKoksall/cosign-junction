generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model PurchaseRequest {
  id             String          @id
  createdAt      DateTime        @db.Timestamptz(3)
  createdBy      String?
  deadline       DateTime        @db.Timestamptz(3)
  quantity       Float
  unit           String
  quantityLiters Int?
  budgetCents    BigInt
  diet           String
  requirements   String[]        @default([])
  freeFromAllergen String[]      @default([])
  rankingObjective String?
  query          String?
  productId      String?
  preset         String?
  proposals      Proposal[]
  order          SimulatedOrder?

  @@index([createdAt, id])
}

model Proposal {
  id                 String          @id
  requestId          String
  request            PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version            Int
  approvedVersion    Int?
  status             String
  totalCents         BigInt
  uncoveredLiters    Float?
  uncoveredQuantity Float?
  uncoveredUnit      String?
  offers             Json
  comparisonMode     String?
  source             String?
  observedAt         DateTime?       @db.Timestamptz(3)
  observationSequence BigInt?
  checkoutSupported  Boolean?
  observations       Json?
  connectedRehearsal Boolean         @default(false)
  rehearsal          Json?
  events             DecisionEvent[]
  order              SimulatedOrder?

  @@unique([requestId, connectedRehearsal])
}

model SimulatedOrder {
  id              String          @id
  requestId       String          @unique
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposalId      String          @unique
  proposal        Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version         Int
  idempotencyKey  String          @unique
  status          String
  totalCents      BigInt
  uncoveredLiters Int
  placedAt        DateTime?       @db.Timestamptz(3)
  mandateId       String?
  mandate         BuyerMandate?   @relation(fields: [mandateId], references: [id])
  mandatePeriod   String?

  @@unique([mandateId, mandatePeriod])
  @@index([placedAt, id])
}

model BuyerMandate {
  id            String           @id
  revision      Int
  active        Boolean
  maxTotalCents BigInt
  updatedAt     DateTime         @db.Timestamptz(3)
  orders        SimulatedOrder[]
}

model DecisionEvent {
  id         BigInt   @id @default(autoincrement())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision   Int?
  actorId    String?
  at         DateTime @db.Timestamptz(3)
  action     String
  outcome    String
  detail     String

  @@index([proposalId, id])
}


// Durable account, OAuth and agent state. Managed by the trade platform migration.
model trade_accounts {
  id                   String                 @id
  name                 String
  email                String                 @unique
  password_hash        String
  customer_id          String
  policy               Json                   @default("{\"requiredClaims\": [], \"freeFromAllergens\": [], \"automaticLimitCents\": 0}")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  trade_authorizations trade_authorizations[]
  trade_events         trade_events[]
  trade_grants         trade_grants[]
  trade_runs           trade_runs[]
  trade_sessions       trade_sessions[]
}

model trade_authorizations {
  hash           String          @id
  client_id      String
  account_id     String?
  params         Json
  expires_at     DateTime        @db.Timestamptz(6)
  approved       Boolean         @default(false)
  trade_accounts trade_accounts? @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trade_clients  trade_clients   @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model trade_clients {
  id                   String                 @id
  metadata             Json
  trade_authorizations trade_authorizations[]
  trade_grants         trade_grants[]
}

model trade_events {
  id             BigInt         @id @default(autoincrement())
  account_id     String
  run_id         String?
  actor_id       String
  action         String
  status         String
  data           Json
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  trade_accounts trade_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trade_runs     trade_runs?    @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, id], map: "trade_events_account")
  @@index([run_id, id], map: "trade_events_run")
}

model trade_grants {
  id             String         @id
  account_id     String
  client_id      String
  scopes         String[]
  revoked_at     DateTime?      @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  trade_accounts trade_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trade_clients  trade_clients  @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trade_tokens   trade_tokens[]
}

model trade_runs {
  id                String             @id
  account_id        String
  actor_id          String
  source            String
  status            String             @default("active")
  title             String
  requirements      Json               @default("{}")
  request_changes   Json               @default("[]")
  comparison        Json?
  draft             Json?
  receipt           Json?
  rehearsal_key_hash String?
  revision          Int                @default(0)
  approved_revision Int?
  approval_waits    Json               @default("[]")
  creation_fingerprint String?
  messages          Json               @default("[]")
  step              Int                @default(0)
  lease_until       DateTime?          @db.Timestamptz(6)
  lease_owner       String?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  trade_events      trade_events[]
  trade_accounts    trade_accounts     @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trade_tool_calls  trade_tool_calls[]

  @@index([account_id, created_at(sort: Desc)], map: "trade_runs_account")
  @@index([source, status, lease_until], map: "trade_runs_jobs")
  @@unique([account_id, rehearsal_key_hash], map: "trade_runs_rehearsal_key")
}

model trade_sessions {
  hash           String         @id
  account_id     String
  expires_at     DateTime       @db.Timestamptz(6)
  trade_accounts trade_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model trade_tokens {
  hash         String       @id
  grant_id     String
  kind         String
  expires_at   DateTime     @db.Timestamptz(6)
  trade_grants trade_grants @relation(fields: [grant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([grant_id], map: "trade_tokens_grant")
}

model trade_tool_calls {
  run_id     String
  call_id    String
  result     Json
  trade_runs trade_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([run_id, call_id])
}
