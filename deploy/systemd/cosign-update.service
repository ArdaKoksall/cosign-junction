[Unit]
Description=Build and deploy Cosign main when changed
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/default/cosign-update
ExecStart=/usr/local/sbin/cosign-update
TimeoutStartSec=25min
UMask=0022
